{
  "font": {
    "family": {
      "$type": "fontFamily",
      "brand": { "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
      "arabic": { "$value": ["Noto Sans Arabic", "Inter", "system-ui", "sans-serif"] },
      "devanagari": { "$value": ["Noto Sans Devanagari", "Inter", "system-ui", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "Menlo", "Consolas", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    }
  },
  "type": {
    "display": { "size": { "$type": "dimension", "$value": "34px" }, "weight": { "$type": "fontWeight", "$value": 500 }, "tracking": { "$type": "dimension", "$value": "-0.9px" }, "leading": { "$type": "number", "$value": 1.12 } },
    "headline": { "size": { "$type": "dimension", "$value": "26px" }, "weight": { "$type": "fontWeight", "$value": 500 }, "tracking": { "$type": "dimension", "$value": "-0.6px" }, "leading": { "$type": "number", "$value": 1.18 } },
    "heading": { "size": { "$type": "dimension", "$value": "21px" }, "weight": { "$type": "fontWeight", "$value": 600 }, "tracking": { "$type": "dimension", "$value": "-0.35px" }, "leading": { "$type": "number", "$value": 1.25 } },
    "title": { "size": { "$type": "dimension", "$value": "17px" }, "weight": { "$type": "fontWeight", "$value": 600 }, "tracking": { "$type": "dimension", "$value": "-0.2px" }, "leading": { "$type": "number", "$value": 1.3 } },
    "subtitle": { "size": { "$type": "dimension", "$value": "15.5px" }, "weight": { "$type": "fontWeight", "$value": 600 }, "tracking": { "$type": "dimension", "$value": "-0.1px" }, "leading": { "$type": "number", "$value": 1.35 } },
    "body": { "size": { "$type": "dimension", "$value": "15.5px" }, "weight": { "$type": "fontWeight", "$value": 400 }, "tracking": { "$type": "dimension", "$value": "0px" }, "leading": { "$type": "number", "$value": 1.45 } },
    "small": { "size": { "$type": "dimension", "$value": "14px" }, "weight": { "$type": "fontWeight", "$value": 400 }, "tracking": { "$type": "dimension", "$value": "0px" }, "leading": { "$type": "number", "$value": 1.4 } },
    "caption": { "size": { "$type": "dimension", "$value": "12.5px" }, "weight": { "$type": "fontWeight", "$value": 400 }, "tracking": { "$type": "dimension", "$value": "0px" }, "leading": { "$type": "number", "$value": 1.35 } },
    "overline": { "size": { "$type": "dimension", "$value": "11px" }, "weight": { "$type": "fontWeight", "$value": 600 }, "tracking": { "$type": "dimension", "$value": "0.9px" }, "leading": { "$type": "number", "$value": 1.3 } }
  }
}
