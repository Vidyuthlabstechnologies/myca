# ==============================================================================
# MyCA Production Environment Configuration Template (.env.example)
# ==============================================================================
# Security Notice:
# 1. Never commit .env or .env.production containing real secrets to Git.
# 2. All keys configured here are loaded automatically by MyCA services.
# 3. For automated interactive setup, run: npm run setup:env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Licensed GSP & GSTN Portal (REQ-CA-006, REQ-CA-008)
# Target: Quicko Sandbox / Licensed GSP (ClearTax, Cygnet, Masters India)
# Docs & Portal: https://developer.sandbox.co.in / https://services.gst.gov.in
# ------------------------------------------------------------------------------
MYCA_GSP_PROVIDER=sandbox
MYCA_GSP_BASE_URL=https://api.sandbox.co.in
MYCA_GSP_API_KEY=
MYCA_GSP_API_SECRET=
MYCA_GSP_ASP_ID=

# ------------------------------------------------------------------------------
# 2. NIC E-Invoice & E-Way Bill (REQ-CA-007)
# Sandbox: https://einv-apisandbox.nic.in / Prod: https://einvoice1.gst.gov.in
# Note: Password and AppKey are encrypted locally using NIC's official RSA .cer PEM.
# ------------------------------------------------------------------------------
MYCA_NIC_ENV=sandbox
MYCA_NIC_CLIENT_ID=
MYCA_NIC_CLIENT_SECRET=
MYCA_NIC_USERNAME=
MYCA_NIC_PASSWORD=
MYCA_NIC_GSTIN=
MYCA_NIC_PUBLIC_KEY_PATH=

# ------------------------------------------------------------------------------
# 3. Income Tax Department, AIS/26AS & TRACES (REQ-CA-009, REQ-CA-010)
# Portals: https://eportal.incometax.gov.in / https://contents.tdscpc.gov.in
# ------------------------------------------------------------------------------
MYCA_ITD_API_KEY=
MYCA_TRACES_USER_ID=
MYCA_TRACES_PASSWORD=
MYCA_TRACES_TAN=

# ------------------------------------------------------------------------------
# 4. TallyPrime Local Sync
# Docs: https://help.tallysolutions.com/tally-prime/integration-tally-prime/tally-xml-data-interchange/
# Default Tally XML port is 9000 on localhost.
# ------------------------------------------------------------------------------
MYCA_TALLY_HOST=127.0.0.1
MYCA_TALLY_PORT=9000
MYCA_TALLY_COMPANY=

# ------------------------------------------------------------------------------
# 5. Zoho Books OAuth 2.0 Integration
# Portal: https://api-console.zoho.in (or zoho.com)
# Docs: https://www.zoho.com/books/api/v3/
# ------------------------------------------------------------------------------
MYCA_ZOHO_CLIENT_ID=
MYCA_ZOHO_CLIENT_SECRET=
MYCA_ZOHO_REFRESH_TOKEN=
MYCA_ZOHO_ORGANIZATION_ID=

# ------------------------------------------------------------------------------
# 6. RBI Account Aggregator (Bank Statement Feeds)
# Providers: Setu (https://setu.co), Finvu, Anumati
# ------------------------------------------------------------------------------
MYCA_AA_PROVIDER=setu
MYCA_AA_CLIENT_ID=
MYCA_AA_CLIENT_SECRET=
MYCA_AA_PRODUCT_INSTANCE_ID=

# ------------------------------------------------------------------------------
# 7. Client Document Chase & WhatsApp Notifications (REQ-CA-012, REQ-CA-013)
# Meta Cloud API: https://developers.facebook.com/docs/whatsapp/cloud-api
# AWS SES: https://aws.amazon.com/ses/
# ------------------------------------------------------------------------------
MYCA_WHATSAPP_PHONE_NUMBER_ID=
MYCA_WHATSAPP_ACCESS_TOKEN=
MYCA_WHATSAPP_BUSINESS_ACCOUNT_ID=
MYCA_AWS_SES_REGION=ap-south-1
MYCA_AWS_ACCESS_KEY_ID=
MYCA_AWS_SECRET_ACCESS_KEY=
MYCA_EMAIL_FROM=

# ------------------------------------------------------------------------------
# 8. Multi-Client Master & Practice Database (REQ-CA-001, REQ-CA-002, REQ-CA-003)
# Storage: PostgreSQL / TigerBeetle / AWS S3 Mumbai (ap-south-1 for DPDPA)
# ------------------------------------------------------------------------------
MYCA_DATABASE_URL=postgresql://myca_user:password@127.0.0.1:5432/myca_firm
MYCA_S3_BUCKET=myca-firm-documents
MYCA_S3_REGION=ap-south-1
MYCA_S3_ACCESS_KEY=
MYCA_S3_SECRET_KEY=

# ------------------------------------------------------------------------------
# 9. Firm Single Sign-On & RBAC (REQ-CA-004)
# Provider: Microsoft Entra ID (Azure AD) or Google Workspace
# ------------------------------------------------------------------------------
MYCA_AUTH_TENANT_ID=
MYCA_AUTH_CLIENT_ID=
MYCA_AUTH_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 10. AI Telemetry, Evals & Quality Monitoring (REQ-CA-015)
# Platform: Langfuse (https://langfuse.com)
# ------------------------------------------------------------------------------
MYCA_LANGFUSE_PUBLIC_KEY=
MYCA_LANGFUSE_SECRET_KEY=
MYCA_LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------------------------------------------
# 11. NVIDIA NIM Free AI Model API (REQ-CA-014, REQ-CA-015)
# Portal: https://build.nvidia.com/ (Free API keys for meta/llama-3.3-70b-instruct, deepseek-r1)
# ------------------------------------------------------------------------------
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ------------------------------------------------------------------------------
# 12. Runtime safety switch
# Outbound calls to external providers (Quicko Sandbox, NVIDIA NIM) are OFF by
# default so the assistant and tools never reach a portal autonomously and tests
# stay offline. Set to 1 only when you intend to make live provider calls.
# ------------------------------------------------------------------------------
MYCA_ENABLE_LIVE_CALLS=0

# ------------------------------------------------------------------------------
# 12b. Mock mode (demo / workflow testing), default OFF.
# MYCA_MOCK_MODE=1 makes every provider front door (Sandbox by Quicko, NIC
# e-invoice, notifications, NVIDIA NIM) return deterministic simulated fixtures
# tagged mock:true — no credentials, no live switch, no approvals, no network.
# Set to 0 the moment you start real filing.
# ------------------------------------------------------------------------------
MYCA_MOCK_MODE=0

# ------------------------------------------------------------------------------
# 13. Client notifications (REQ-CA-013)
# WhatsApp uses the Meta Cloud API. Email uses a generic JSON relay so any
# provider (SES, Postmark, your own function) can be wired without vendor code.
# Sending is gated by MYCA_ENABLE_LIVE_CALLS.
# ------------------------------------------------------------------------------
MYCA_WHATSAPP_PHONE_NUMBER_ID=
MYCA_EMAIL_FROM=
MYCA_EMAIL_RELAY_URL=
MYCA_EMAIL_RELAY_TOKEN=

# ------------------------------------------------------------------------------
# 14. Sandbox by Quicko environment selection (REQ-CA-006..010)
# MYCA_GSP_ENV is optional: when it is absent the environment is inferred from the
# base URL ("test" if the URL contains "test", else "live"). Scoped keys win over
# the generic MYCA_GSP_API_KEY/API_SECRET. The app reports which environment and
# key it used, and warns when responses are TEST fixtures rather than real data.
#   TEST base: https://test-api.sandbox.co.in  (returns provider fixtures)
#   LIVE base: https://api.sandbox.co.in
# ------------------------------------------------------------------------------
MYCA_GSP_ENV=
