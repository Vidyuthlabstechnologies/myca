{
  "name": "myca",
  "version": "0.1.0",
  "private": true,
  "description": "MyCA — Windows books + GST + CA workbench. Invoice is the source of truth; NIC/GSTN APIs when you have credentials.",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "test": "node --env-file=.env.test --test \"test/*.test.mjs\"",
    "posttest": "node scripts/clean-test-temp.mjs",
    "start": "electron .",
    "dev": "node src/server.mjs",
    "stress": "node scripts/stress.mjs",
    "shadow": "node scripts/shadow.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "check:env": "node scripts/setup-env.mjs --check",
    "pack": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "in.myca.app",
    "productName": "MyCA",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "src/**"
    ],
    "extraResources": [
      {
        "from": "../sprints",
        "to": "sprints",
        "filter": ["**/*.mjs", "**/*.csv", "**/*.json"]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  }
}
